library(ggplot2)
library(dplyr)
library(forcats)
ggplot(
do215_events,
aes(
x = fct_reorder(category, upvotes, .fun = median),
y = upvotes
)
) +
# Distribution
geom_boxplot(
aes(fill = category),
alpha = 0.65,
outlier.shape = NA,
width = 0.65
) +
# Individual events
geom_jitter(
width = 0.15,
alpha = 0.45,
size = 2
) +
# Median
stat_summary(
fun = median,
geom = "point",
shape = 18,
size = 3,
color = "black"
) +
coord_flip() +
labs(
title = "User Interest Across Event Categories",
subtitle = "Distribution of upvotes for events featured on Do215 Top Picks",
x = "Event Category",
y = "Number of Upvotes",
caption = "Source: Do215 Top Picks"
) +
theme_minimal(base_size = 13) +
theme(
legend.position = "none",
plot.title = element_text(
face = "bold",
size = 17
),
plot.subtitle = element_text(
size = 11,
color = "gray40"
),
axis.title = element_text(
face = "bold"
),
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank()
)
ggplot(
category_summary,
aes(
x = reorder(category, avg_upvotes),
y = avg_upvotes
)
) +
geom_col(
width = 0.7
) +
geom_text(
aes(
label = round(avg_upvotes, 1)
),
hjust = -0.1,
size = 4
) +
coord_flip() +
labs(
title = "Average User Interest by Event Category",
subtitle = "Average number of upvotes per event",
x = "Event Category",
y = "Average Upvotes"
) +
theme_minimal(base_size = 13) +
theme(
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
plot.title = element_text(
face = "bold",
size = 17
)
) +
expand_limits(
y = max(category_summary$avg_upvotes, na.rm = TRUE) * 1.15
)
library(ggplot2)
library(dplyr)
library(tidyr)
library(forcats)
# Prepare data
category_plot <- category_summary %>%
select(
category,
n_events,
avg_upvotes,
avg_attendees
) %>%
pivot_longer(
cols = c(avg_upvotes, avg_attendees),
names_to = "measure",
values_to = "value"
) %>%
mutate(
measure = recode(
measure,
avg_upvotes = "Average Upvotes",
avg_attendees = "Average Attendees"
),
category = fct_reorder(
category,
ifelse(
measure == "Average Upvotes",
value,
NA_real_
),
.fun = median,
na.rm = TRUE
),
category_label = paste0(
str_to_title(as.character(category)),
" (n = ", n_events, ")"
)
)
# Plot
ggplot(
category_plot,
aes(
x = fct_reorder(
category_label,
value,
.fun = median
),
y = value,
fill = measure
)
) +
geom_col(
position = position_dodge(width = 0.75),
width = 0.65
) +
geom_text(
aes(
label = round(value, 1)
),
position = position_dodge(width = 0.75),
hjust = -0.15,
size = 3.7,
fontface = "bold"
) +
scale_fill_manual(
values = c(
"Average Upvotes" = "#155A8A",
"Average Attendees" = "#8BB8D8"
)
) +
coord_flip() +
labs(
title = "User Interest and Attendance by Event Category",
subtitle = "Average upvotes and attendee counts per event",
x = "Event Category",
y = "Average Count",
fill = NULL,
caption = "Source: Do215 Top Picks"
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(
size = 18,
face = "bold"
),
plot.subtitle = element_text(
size = 11.5,
color = "gray40"
),
plot.caption = element_text(
size = 9,
color = "gray50"
),
axis.title = element_text(
face = "bold"
),
axis.text.y = element_text(
size = 10.5
),
legend.position = "top",
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_line(
color = "gray85",
linewidth = 0.4
)
)
category_scatter <- category_summary %>%
mutate(
category_label = str_to_title(category)
)
ggplot(
category_scatter,
aes(
x = avg_attendees,
y = avg_upvotes,
size = n_events,
label = category_label
)
) +
geom_point(
alpha = 0.75,
color = "#155A8A"
) +
geom_text(
vjust = -1,
size = 4,
color = "#1F3F5B"
) +
geom_smooth(
method = "lm",
se = FALSE,
color = "gray50",
linetype = "dashed"
) +
labs(
title = "User Interest vs. Attendance",
subtitle = "Average upvotes and attendee counts by event category",
x = "Average Attendees",
y = "Average Upvotes",
size = "Number of Events",
caption = "Source: Do215 Top Picks"
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(
size = 18,
face = "bold"
),
plot.subtitle = element_text(
size = 11.5,
color = "gray40"
),
panel.grid.minor = element_blank()
)
install.packages("ggrepel")
library(ggplot2)
library(dplyr)
library(ggrepel)
category_scatter <- category_summary %>%
mutate(
category_label = paste0(
str_to_title(category),
" (n = ", n_events, ")"
)
)
ggplot(
category_scatter,
aes(
x = avg_attendees,
y = avg_upvotes
)
) +
# Points
geom_point(
aes(size = n_events),
color = "#176B9A",
alpha = 0.75
) +
# Labels
geom_text_repel(
aes(label = category_label),
color = "#174A6E",
size = 3.8,
fontface = "bold",
box.padding = 0.6,
point.padding = 0.5,
force = 2,
max.overlaps = Inf,
min.segment.length = 0,
segment.color = "gray60"
) +
# Bubble size without displaying legend
scale_size(
range = c(3, 9),
guide = "none"
) +
labs(
title = "User Interest vs. Attendance",
subtitle = "Average upvotes and attendee counts by event category",
x = "Average Attendees per Event",
y = "Average Upvotes per Event",
caption = "Source: Do215 Top Picks"
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(
size = 19,
face = "bold"
),
plot.subtitle = element_text(
size = 11.5,
color = "gray40"
),
plot.caption = element_text(
size = 9,
color = "gray50"
),
axis.title = element_text(
face = "bold"
),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(
color = "gray88",
linewidth = 0.4
),
plot.margin = margin(
15, 35, 15, 15
)
)
library(ggplot2)
library(dplyr)
library(ggrepel)
library(stringr)
# Categories to label
label_data <- category_summary %>%
filter(n_events >= 5) %>%
mutate(
category_label = paste0(
str_to_title(category),
" (n = ", n_events, ")"
)
)
ggplot(
category_summary,
aes(
x = avg_attendees,
y = avg_upvotes
)
) +
# All categories
geom_point(
size = 4,
color = "#2B78A5",
alpha = 0.75
) +
# Labels for categories with enough observations
geom_text_repel(
data = label_data,
aes(
label = category_label
),
size = 4,
fontface = "bold",
color = "#164A70",
box.padding = 0.7,
point.padding = 0.5,
force = 2,
max.overlaps = Inf,
min.segment.length = 0,
segment.color = "gray65"
) +
labs(
title = "User Interest vs. Attendance",
subtitle = "Average upvotes and attendee counts by event category",
x = "Average Attendees per Event",
y = "Average Upvotes per Event",
caption = "Source: Do215 Top Picks"
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(
size = 18,
face = "bold"
),
plot.subtitle = element_text(
size = 11.5,
color = "gray40"
),
plot.caption = element_text(
size = 9,
color = "gray50"
),
axis.title = element_text(
face = "bold"
),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(
color = "gray88",
linewidth = 0.4
)
)
category_scatter <- category_summary %>%
mutate(
category_label = paste0(
str_to_title(category),
" (n = ", n_events, ")"
),
log_avg_attendees = log1p(avg_attendees),
log_avg_upvotes = log1p(avg_upvotes)
)
ggplot(
category_scatter,
aes(
x = log_avg_attendees,
y = log_avg_upvotes
)
) +
geom_point(
aes(size = n_events),
color = "#176B9A",
alpha = 0.75
) +
geom_text_repel(
aes(label = category_label),
color = "#174A6E",
size = 3.8,
fontface = "bold",
box.padding = 0.6,
point.padding = 0.5,
force = 2,
max.overlaps = Inf,
min.segment.length = 0,
segment.color = "gray60"
) +
scale_size(
range = c(3, 9),
guide = "none"
) +
labs(
title = "User Interest vs. Attendance Across Event Categories",
subtitle = "Average values shown on a log(1 + x) scale",
x = "Average Attendees [log(1 + x)]",
y = "Average Upvotes [log(1 + x)]",
caption = "Source: Do215 Top Picks"
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(
size = 18,
face = "bold"
),
plot.subtitle = element_text(
size = 11.5,
color = "gray40"
),
panel.grid.minor = element_blank()
)
