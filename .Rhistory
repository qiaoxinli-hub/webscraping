category_summary <- do215_events %>%
group_by(category) %>%
summarise(
n_events = n(),
total_upvotes = sum(upvotes, na.rm = TRUE),
total_attendees = sum(attendees, na.rm = TRUE),
avg_upvotes = mean(upvotes, na.rm = TRUE),
